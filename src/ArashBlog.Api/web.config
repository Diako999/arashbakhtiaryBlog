<?xml version="1.0" encoding="utf-8"?>
<!-- Checked into source (rather than relying on the SDK's auto-generated
     web.config) so these settings survive every `dotnet publish` instead of
     needing to be hand-patched each time:
     - hostingModel=outofprocess: the ASP.NET Core Module's default
       "inprocess" hosting caused a silent 500.30 startup failure on this
       Plesk/IIS host for reasons never fully diagnosed; outofprocess works.
     - stdoutLogEnabled=true: only real way to see startup errors when there
       is no SSH/RDP access to the production host.
     - WebDAVModule removed: IIS ships this module enabled by default on
       many hosts, and it intercepts PUT/DELETE requests before they ever
       reach Kestrel/the app, returning a bare 405 with nothing in the app's
       own logs. This was the actual cause of every "PUT .../api/dashboard/*
       returns 405" bug reported against this deployment. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <aspNetCore processPath=".\ArashBlog.Api.exe" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
