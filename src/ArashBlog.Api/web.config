<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- IIS's WebDAV Publishing feature intercepts PUT/DELETE before they
           reach ASP.NET Core and answers with 405 Method Not Allowed — this
           API uses PUT for every dashboard "save" (posts, offerings,
           testimonials, site/theme settings) and DELETE for removal, so
           without this, every edit in the dashboard is broken on a server
           that has WebDAV Publishing enabled (common default on many
           Windows Server/shared-hosting setups). Present here (not just
           patched on the server) so it survives every future publish. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Enabled (was false): with no shell/RDP access to the host, the
           logs/ folder viewed through Plesk's File Manager is the only way
           to see why a startup failure happened, so this needs to already
           be on by the time one occurs — turning it on only after the
           fact doesn't help retroactively. ANCM rotates/creates the
           timestamped file itself; the logs/ folder just needs to exist
           (see logs/.gitkeep) since IIS won't create it on demand. -->
      <aspNetCore processPath="dotnet" arguments=".\ArashBlog.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
